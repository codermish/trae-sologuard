# Environment Variables for TravelHub

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/travelhub"

# Redis
REDIS_URL="redis://localhost:6379"

# Authentication
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# Stripe Payment
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"
STRIPE_PUBLISHABLE_KEY="pk_test_your_publishable_key"

# Email (SendGrid)
SENDGRID_API_KEY="SG.your_sendgrid_api_key"
FROM_EMAIL="noreply@travelhub.com"
FROM_NAME="TravelHub"

# Maps (Mapbox)
MAPBOX_ACCESS_TOKEN="pk.your_mapbox_access_token"

# External APIs (Mock for development)
FLIGHT_API_KEY="mock_flight_api_key"
HOTEL_API_KEY="mock_hotel_api_key"
WEATHER_API_KEY="your_weather_api_key"

# Application Settings
NODE_ENV="development"
PORT=3001
CLIENT_URL="http://localhost:5173"
API_URL="http://localhost:3001"

# Security
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# File Upload
MAX_FILE_SIZE=5242880 # 5MB
UPLOAD_PATH="./uploads"

# Cache Settings
CACHE_TTL=3600 # 1 hour
SEARCH_CACHE_TTL=300 # 5 minutes

# Email Templates
EMAIL_TEMPLATE_PATH="./templates"

# Analytics
GOOGLE_ANALYTICS_ID=""
HOTJAR_ID=""

# Social Auth (Optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""